<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>TexasHoldemGameEngine</id>
    <version>2.0.0</version>
    <authors>Nikolay.IT</authors>
    <owners>Nikolay.IT</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/NikolayIT/TexasHoldemGameEngine</projectUrl>
    <description>Game engine for the Texas Hold'em poker card game (a variation of the standard card game of poker).</description>
    <releaseNotes>Update to .NET Standard 2.0. Lots of community improvements. See https://github.com/NikolayIT/TexasHoldemGameEngine/compare/1.1...2.0</releaseNotes>
    <copyright>Copyright (c) 2015-2020 Nikolay Kostov</copyright>
    <tags>Texas, Hold'em, holdem, poker, card game</tags>
    <repository type="GitHub" url="https://github.com/NikolayIT/TexasHoldemGameEngine" />
    <dependencies>
      <group targetFramework=".NETStandard2.0" />
    </dependencies>
  </metadata>
</package>